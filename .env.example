# AWS
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Snowflake
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=FINTECH
SNOWFLAKE_SCHEMA=RAW

# Kafka
# Use `kafka:29092` when running inside Docker, `localhost:9092` from the host.
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_TOPIC=financial-transactions
KAFKA_CONSUMER_GROUP=transaction-consumer-group

# S3 (raw landing zone)
S3_BUCKET=fintech-data-platform-azam-2026
S3_PREFIX=raw/transactions

# PaySim source dataset (mounted into the producer container)
PAYSIM_FILE=/data/paysim-dataset.csv

# --- Optional producer tuning (defaults shown) ---
# EVENT_DELAY_SECONDS=1
# MAX_EVENTS=10

# --- Optional consumer tuning (defaults shown) ---
# BATCH_SIZE=100
# BATCH_TIMEOUT_SECONDS=30
